    <string name="app_name">考试监督</string>
    <string name="accessibility_description">读取当前屏幕，将题目和选项发送至你配置的 DeepSeek API，并自动点击选项。任务在后台运行，可从通知栏关闭。支持安卓 11 及以上。</string>
